# Maintainer: niruxxdaboi <perezkyle6@gmail.com>
#
# Builds from the local working tree (two directories up), not a
# downloaded tarball. Run `makepkg -si` from this directory.
pkgname=channex
pkgver=0.2.0
pkgrel=1
pkgdesc="Native GTK/libadwaita viewer for chan-style imageboards"
arch=('x86_64' 'aarch64')
url="https://github.com/niruxx/Channex"
license=('LicenseRef-unknown')
depends=('gtk4' 'libadwaita' 'glib2' 'cairo' 'pango' 'gdk-pixbuf2' 'graphene' 'gcc-libs' 'glibc')
# Video and GIF playback in the media viewer.
optdepends=('gst-plugins-good: play webm videos and GIFs'
            'gst-libav: play mp4 videos')
# cmake: builds aws-lc, the TLS crypto library.
makedepends=('cargo' 'blueprint-compiler' 'cmake')
# makepkg's LTO flags turn the bundled C crypto library (aws-lc) into
# LTO bitcode that the Rust linker can't resolve.
options=('!lto')
source=()
sha256sums=()

_srcroot="$(realpath "$startdir/../..")"
_appid=io.github.niruxx.Channex

prepare() {
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --manifest-path "$_srcroot/Cargo.toml" \
    --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  export RUSTUP_TOOLCHAIN=stable
  # Keep build output out of the working tree.
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release --manifest-path "$_srcroot/Cargo.toml"
}

check() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release --manifest-path "$_srcroot/Cargo.toml"
}

package() {
  install -Dm755 "$srcdir/target/release/channex" "$pkgdir/usr/bin/channex"
  install -Dm644 "$_srcroot/data/$_appid.desktop" "$pkgdir/usr/share/applications/$_appid.desktop"
  install -Dm644 "$_srcroot/data/$_appid.metainfo.xml" "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"
  install -Dm644 "$_srcroot/data/icons/hicolor/scalable/apps/$_appid.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_appid.svg"
}
